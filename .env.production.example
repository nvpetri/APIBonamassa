# MODELO: preencher valores privados no Environment, nunca no Git.
NODE_ENV=production
APP_ENV=production
# Preservar parâmetros do provedor sem duplicar sslmode/sslaccept.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require&sslaccept=strict
CORS_ORIGINS=
DOCS_ENABLED=false
SESSION_HOURS=720
SESSION_IDLE_DAYS=5
SEED_DEMO=false
# Piloto com participantes já cadastrados. Novos cadastros ficam suspensos.
CUSTOMER_REGISTRATION_ENABLED=false
# Sem confiança implícita. Validar a topologia antes de preencher.
TRUSTED_PROXY_CIDRS=
# PORT é fornecida pelo Render.
# Credenciais SEED_MANAGER_* são temporárias, somente no bootstrap autorizado.
