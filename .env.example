NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://bonamassa:local-only-change-me@localhost:5432/bonamassa?schema=public
POSTGRES_PASSWORD=local-only-change-me
CORS_ORIGINS=http://localhost:3000
DOCS_ENABLED=true
SESSION_HOURS=720
SESSION_IDLE_DAYS=5
SEED_STORE_SLUG=bonamassa
SEED_MANAGER_EMAIL=gestor@example.com
# Obrigatório: escolha uma senha de ao menos 12 caracteres, diferente de exemplos.
SEED_MANAGER_PASSWORD=
# true cadastra exemplos de cardápio e abre a loja; false cria somente loja fechada + gestor.
SEED_DEMO=false
# Testes de integração apagam somente a loja de teste aleatória; use banco separado.
TEST_DATABASE_URL=postgresql://bonamassa:local-only-change-me@localhost:5432/bonamassa_test?schema=public

# E-mail transacional (obrigatório em produção para verificação e recuperação de senha)
EMAIL_API_KEY=
EMAIL_FROM=Bonamassa <onboarding@resend.dev>
EMAIL_API_URL=https://api.resend.com/emails
VERIFICATION_CODE_MINUTES=10
